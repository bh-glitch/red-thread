# Copy to .env. The complete scripted demo works without any keys.
DEMO_MODE=false
GEMINI_API_KEY=
NESSIE_API_KEY=
# Character dialogue: Gemini first (auto), local Ollama if Gemini fails. Must be a model your key lists.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# Primary speech provider, with automatic expressive local fallback.
GEMINI_VOICE_ENABLED=true
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
NESSIE_BASE_URL=http://api.nessieisreal.com
# Local fallback weights are installed automatically by make dev.
TTS_PROVIDER=gemini
QWEN_VOICE_ENABLED=true
KOKORO_ENABLED=true
CHAT_PROVIDER=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b-q4_K_M

# Optional local player-save path; leave unset for backend/data/player_progress.sqlite3.
# LEDGER_SESSION_DB=
